---
import site from '../../content/site.json';
const customFiles = import.meta.glob('../../content/pages/*.json', { eager: true });
const customLinks = Object.entries(customFiles).map(([path, mod]: any) => ({ href: `/${path.split('/').pop().replace('.json', '')}/`, label: mod.default.menu_label || mod.default.title, order: mod.default.menu_order || 99, show: mod.default.show_in_menu && mod.default.published !== false })).filter((item) => item.show).sort((a, b) => a.order - b.order);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="brand-name">{site.church_name}</span>
        <p>{site.footer_blurb}</p>
        <div class="social">
          <a href={site.youtube} aria-label="YouTube channel" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 00-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.5A2.5 2.5 0 001.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 001.8 1.8C4.7 19 12 19 12 19s7.3 0 8.8-.5a2.5 2.5 0 001.8-1.8C23 15.2 23 12 23 12zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z" /></svg></a>
          <a href={site.instagram} aria-label="Instagram" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg></a>
          <a href={site.facebook} aria-label="Facebook" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1z" /></svg></a>
        </div>
      </div>
      <div>
        <h4>Explore</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/statement-of-faith/">Statement of Faith</a></li>
          <li><a href="/messages/">Sunday Messages</a></li>
          {customLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Connect</h4>
        <ul class="footer-links">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>Meeting place: {site.meeting_place}</li>
          <li>{site.service_time}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {site.church_name}. Looking forward to connecting!</span>
      <span>{site.footer_tagline}</span>
    </div>
  </div>
</footer>
