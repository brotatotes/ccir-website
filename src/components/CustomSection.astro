---
const { section } = Astro.props;
const youtubeId = (url = '') => url.match(/(?:v=|youtu\.be\/|embed\/|shorts\/|live\/)([A-Za-z0-9_-]{11})/)?.[1] ?? '';
const id = section.type === 'video' ? youtubeId(section.youtube) : '';
---
{section.type === 'text' && <section class:list={['section', {'section--tint': section.shaded}]}><div class="wrap"><div class="prose" style="max-width:48rem;">{section.heading && <h2 class="section-title">{section.heading}</h2>}<div set:html={section.body} /></div></div></section>}
{section.type === 'image_text' && <section class:list={['section', {'section--tint': section.shaded}]}><div class="wrap split">{section.image_side !== 'right' && <div class="split-media"><img src={section.image} loading="lazy" alt={section.image_alt} /></div>}<div>{section.heading && <h2 class="section-title">{section.heading}</h2>}<div class="prose stack mt-2" set:html={section.body} /></div>{section.image_side === 'right' && <div class="split-media"><img src={section.image} loading="lazy" alt={section.image_alt} /></div>}</div></section>}
{section.type === 'columns' && <section class:list={['section', {'section--tint': section.shaded}]}><div class="wrap">{section.heading && <div class="section-head"><h2 class="section-title">{section.heading}</h2></div>}<div class:list={['grid', section.columns?.length === 2 ? 'cols-2' : 'cols-3']}>{section.columns?.map((column) => <div class="prose"><h3>{column.heading}</h3><div set:html={column.text} /></div>)}</div></div></section>}
{section.type === 'video' && <section class:list={['section', {'section--tint': section.shaded}]}><div class="wrap" style="max-width:48rem;"><div class="video-grid" style="grid-template-columns:1fr;"><article class="video-card"><div class="video-embed" role="button" tabindex="0" data-yt={id} data-title={section.title} aria-label={`Play video: ${section.title}`}><img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} loading="lazy" alt={`Thumbnail for ${section.title}`} /></div><div class="meta"><h3>{section.title}</h3><a href={section.youtube}>Watch on YouTube →</a></div></article></div></div></section>}
{section.type === 'cta' && <section class="section section--navy cta-band"><div class="wrap"><h2>{section.heading}</h2><p>{section.text}</p><div class="cta-actions"><a class="btn btn--accent" href={section.button_link}>{section.button_label}</a></div></div></section>}
