---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import contact from '../../content/contact.json';
import site from '../../content/site.json';
---
<BaseLayout title="Contact — Christian Church In Raleigh" description="Contact Christian Church In Raleigh and learn about Sunday service, weekly Bible studies, prayer, and home gatherings in the Raleigh–Durham area." path="/contact/" active="contact">
  <PageBanner eyebrow={contact.eyebrow} title={contact.title} intro={contact.intro} />
  <section class="section section--tint"><div class="wrap"><div class="section-head"><p class="eyebrow">{contact.schedule_eyebrow}</p><h2 class="section-title">{contact.schedule_heading}</h2></div><div class="grid cols-3">{contact.schedule.map((item) => <article class="card"><h3>{item.title}</h3><ul class="schedule">{item.times.map((time) => <li><span class="day">{time.day}</span><span class="time">{time.time}</span></li>)}</ul><p style="margin:.9rem 0 0;color:var(--muted);font-size:.95rem;">{item.note}</p></article>)}</div></div></section>
  <section class="section"><div class="wrap"><div class="contact-grid"><div><div class="section-head"><p class="eyebrow">Get in touch</p><h2 class="section-title">Reach out any time</h2></div><ul class="info-list">
    <li><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span><span class="label">Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></span></li>
    <li><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.2-7-11a7 7 0 0114 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span><span class="label">Where we meet</span>{contact.meeting_place}<br /><span style="color:var(--muted);font-size:.92rem;">{contact.meeting_note}</span></span></li>
    <li><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><span class="label">Sunday service</span>{contact.sunday_service}</span></li>
    <li><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 00-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.5A2.5 2.5 0 001.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 001.8 1.8C4.7 19 12 19 12 19s7.3 0 8.8-.5a2.5 2.5 0 001.8-1.8C23 15.2 23 12 23 12z"/></svg></span><span><span class="label">Follow along</span><a href={site.youtube}>YouTube</a> · <a href={site.instagram}>Instagram</a> · <a href={site.facebook}>Facebook</a></span></li>
  </ul></div><div class="form-panel"><h2 style="font-size:1.3rem;margin:0 0 1rem;">Send us a message</h2><!-- Formspree endpoint is not connected. Keep this form disabled until one exists. --><div class="form-note" role="note"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg><span><strong>This form isn't live yet.</strong> While we finish connecting it, please email us directly at <a href={`mailto:${contact.email}`}>{contact.email}</a>. We read every message.</span></div><form data-demo="true" aria-describedby="form-demo-hint" novalidate><div class="field"><label for="name">Your name</label><input type="text" id="name" name="name" autocomplete="name" placeholder="First and last name" disabled /></div><div class="field"><label for="email">Email address</label><input type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" disabled /></div><div class="field"><label for="message">Message</label><textarea id="message" name="message" placeholder="Tell us a little about yourself or ask us anything…" disabled></textarea></div><button class="btn btn--accent" type="submit" disabled aria-disabled="true">Send message (coming soon)</button><p id="form-demo-hint" style="margin:.9rem 0 0;font-size:.85rem;color:var(--muted);">Prefer email? Write to us at <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p></form></div></div></div></section>
  <CtaBand heading={contact.cta_heading} text={contact.cta_text}><a class="btn btn--accent" href={`mailto:${contact.email}`}>Email us</a></CtaBand>
</BaseLayout>
