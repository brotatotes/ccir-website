---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  path?: string;
  active?: 'home' | 'faith' | 'messages' | 'contact' | string;
  noindex?: boolean;
}
const { title, description, path = '/', active = '', noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/img/og-card.png', Astro.site)} />
    <meta name="theme-color" content="#3f4359" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/assets/img/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/img/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main"><slot /></main>
    <Footer />
    <script src="/assets/main.js" defer></script>
  </body>
</html>
